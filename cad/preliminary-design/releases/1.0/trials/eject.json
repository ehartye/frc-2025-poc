{
  "note": "Eject into the L1 trough (recorded as eject-nominal, G2): 12 V open loop at a 50 mm stand-off, then withdraw 120 mm and hold 2 s.",
  "assumes": [
    {"id": "pipe-square", "text": "The pipe arrives square to the chute and stays square, its axis across the robot."},
    {
      "id": "contact-line",
      "text": "The robot's pipe-contact surfaces are the contact lines of the pocket section (inlet, floor, hood, flare and lip), typed from the design's parameters; the drawn solids sit 2.5 mm (lip 3.5 mm) below them as the clearance reserve."
    },
    {
      "id": "tread-circle",
      "text": "Each roller is its 2 in tread circle on the axis the parameters place, with the tread's compliance as its contact spring; the drawn roller solid is only the rigid core, so the tread is typed."
    },
    {
      "id": "plane-20",
      "text": "The section is 20 mm off the pipe's centre plane, where the official station chute plate is solid; at the centre plane it is cut by one of its 32 mm slots, which the 302 mm pipe bridges."
    },
    {
      "id": "trough-section",
      "text": "The official trough is cut at the section plane: its panel holes, the sector divider and the riser's 245 mm extent along the 302 mm pipe are not seen."
    },
    {
      "id": "nominal-seat",
      "text": "The pipe starts at rest on the design's carry seat, the nominal receive's end state, whatever the tread stiffness; the recorded campaign started each stiffness at its own receive seat (304.10 to 308.57 mm)."
    }
  ],
  "plane": {"normal": "y", "atMm": 20},
  "stepS": 4e-05,
  "durationS": 8.0,
  "traceS": 0.002,
  "fitToleranceMm": 10,
  "planar": {"frictionLaw": "stick", "tangentStiffnessNPerM": 20000.0},
  "piece": {"use": "pipe", "start": {"atMm": ["=seat_x", "=seat_z"]}},
  "surfaces": [
    {
      "name": "inlet",
      "material": "panel",
      "segmentsMm": [["=entry_x", "=entry_z"], ["=kink_x", "=kink_z"], ["=floor_end_x", "=floor_end_z"]],
      "mover": "withdraw"
    },
    {"name": "hood", "material": "panel", "segmentsMm": [["=hood0_x", "=hood0_z"], ["=hood1_x", "=hood1_z"]], "mover": "withdraw"},
    {"name": "hood flare", "material": "panel", "segmentsMm": [["=flare_x", "=flare_z"], ["=hood0_x", "=hood0_z"]], "mover": "withdraw"},
    {
      "name": "lip",
      "material": "panel",
      "segmentsMm": [["=lip_root_x", "=lip_root_z"], ["=lip_knee_x", "=lip_tip_z"], ["=lip_tip_x", "=lip_tip_z"]],
      "mover": "withdraw"
    },
    {
      "name": "nip",
      "material": "tread",
      "drive": "nip",
      "runs": "clockwise",
      "circleMm": {"centreMm": ["=throat_x", "=lower_roller_z"], "radiusMm": "=roller_r"},
      "mover": "withdraw"
    },
    {
      "name": "nip",
      "material": "tread",
      "drive": "nip",
      "circleMm": {"centreMm": ["=throat_x", "=upper_roller_z"], "radiusMm": "=roller_r"},
      "mover": "withdraw"
    },
    {"name": "trough lip", "material": "panel", "solid": "Reef trough lip and base plates (GE-25302, GE-25311)"},
    {"name": "trough floor", "material": "panel", "solid": "Reef trough floor, docked sector (GE-25313)"},
    {"name": "trough riser", "material": "panel", "solid": "Reef trough riser, docked sector (GE-25315)"}
  ],
  "flaps": [
    {
      "name": "flap",
      "material": "panel",
      "hingeMm": ["=flap_x", "=flap_hinge_z"],
      "lengthMm": "=flap_length",
      "restDirection": [0, -1],
      "inertiaKgM2": {"value": 0.00024, "assumed": [0.00012, 0.00048], "note": "1.6 mm polycarbonate plate about its pin: an estimate"},
      "preloadNm": {"value": 0.04, "assumed": [0.01, 0.08], "note": "Torsion spring preload, set on assembly; the recorded campaign tried 0.01 as a weak spring"},
      "springNmPerRad": {"value": 0.06, "assumed": [0.015, 0.12], "note": "Torsion spring rate: an estimate"},
      "dampingNmSPerRad": {"value": 0.0002, "assumed": [0.0001, 0.0004], "note": "Pin friction as viscous damping: an estimate"},
      "limitDeg": "=flap_open_deg",
      "stopRestitution": {"value": 0.3, "assumed": [0.1, 0.5], "note": "Bounce off the open stop: an estimate"},
      "mover": "withdraw"
    }
  ],
  "commands": {"nip": {"mode": "voltage", "busV": 12.0}},
  "movers": {"withdraw": {"velocityMps": [-0.3, 0.0], "after": "resting off the lip", "durationS": 0.4}},
  "events": [
    {"name": "left the lip", "when": {"signal": "xMm", "above": "=lip_tip_x - 0.5"}},
    {
      "name": "lost over riser",
      "when": {"all": [{"signal": "xMm", "above": "=trough_riser_x + 4"}, {"signal": "zMm", "above": "=trough_riser_top"}]},
      "outcome": "lost over riser"
    },
    {
      "name": "fell short",
      "when": {"all": [{"signal": "zMm", "below": 380}, {"signal": "xMm", "below": "=trough_lip_x + trough_lip_depth + 20"}]},
      "outcome": "fell short / out over lip"
    },
    {"name": "fell", "when": {"signal": "zMm", "below": 380}, "outcome": "fell"},
    {
      "name": "stalled",
      "when": {
        "any": [
          {"all": [{"signal": "tS", "above": 0.5}, {"restFor": 0.2}, {"signal": "xMm", "below": "=throat_x + 25"}]},
          {"all": [{"signal": "tS", "above": 6.0}, {"signal": "xMm", "below": "=throat_x + 25"}]}
        ]
      },
      "outcome": "stalled in the nip"
    },
    {
      "name": "retained on robot",
      "when": {"all": [{"signal": "tS", "above": 0.5}, {"restFor": 0.2}, {"signal": "xMm", "below": "=lip_tip_x + 5"}, {"notYet": "resting off the lip"}]},
      "outcome": "retained on robot"
    },
    {"name": "resting off the lip", "when": {"all": [{"signal": "tS", "above": 0.5}, {"restFor": 0.2}, {"signal": "xMm", "above": "=lip_tip_x + 5"}]}},
    {
      "name": "captured",
      "when": {
        "all": [
          {"after": "resting off the lip", "delayS": 2.0},
          {"restFor": 2.0},
          {"signal": "xMm", "above": "=trough_lip_x"},
          {"signal": "xMm", "below": "=trough_riser_x"},
          {"signal": "zMm", "below": "=trough_lip_top + pipe_r"}
        ]
      },
      "outcome": "captured and supported 2 s after withdrawal"
    },
    {"name": "outside", "when": {"all": [{"after": "resting off the lip", "delayS": 2.0}, {"restFor": 2.0}]}, "outcome": "at rest outside trough"}
  ],
  "measures": {
    "leftLipS": {"timeOf": "left the lip"},
    "endXMm": {"final": "xMm"},
    "endZMm": {"final": "zMm"},
    "maxCurrentA": {"peak": "drive.nip.currentA"},
    "lowestNipMps": {"lowest": "drive.nip.speedMps"},
    "maxBiteN": {"peak": "contact.nip.forceN"}
  },
  "pass": {"outcomes": ["captured and supported 2 s after withdrawal"]},
  "control": {"change": {"surfaces.lip": null}, "note": "The exit lip removed: the pipe must fall short of the trough at the 50 mm stand-off."},
  "brackets": [
    {
      "input": "parameters.reef_standoff",
      "unit": "mm",
      "values": [0, 25, 50, 75, 100, 125, 150],
      "note": "Front bumper to the trough lip face; the recorded campaign tried 0 to 100 and 125"
    }
  ],
  "adjustments": ["nip squeeze", "eject voltage"]
}
