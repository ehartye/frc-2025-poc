{
  "note": "Station receive (recorded as receive-nominal, G1): released from rest on the official chute at a 10 mm dock gap, into the held nip.",
  "assumes": [
    {"id": "pipe-square", "text": "The pipe arrives square to the chute and stays square, its axis across the robot."},
    {
      "id": "contact-line",
      "text": "The robot's pipe-contact surfaces are the contact lines of the pocket section (inlet, floor, hood, flare and lip), typed from the design's parameters; the drawn solids sit 2.5 mm (lip 3.5 mm) below them as the clearance reserve."
    },
    {
      "id": "tread-circle",
      "text": "Each roller is its 2 in tread circle on the axis the parameters place, with the tread's compliance as its contact spring; the drawn roller solid is only the rigid core, so the tread is typed."
    },
    {
      "id": "plane-20",
      "text": "The section is 20 mm off the pipe's centre plane, where the official station chute plate is solid; at the centre plane it is cut by one of its 32 mm slots, which the 302 mm pipe bridges."
    }
  ],
  "plane": {"normal": "y", "atMm": 20},
  "stepS": 4e-05,
  "durationS": 3.0,
  "traceS": 0.002,
  "fitToleranceMm": 10,
  "planar": {"frictionLaw": "stick", "tangentStiffnessNPerM": 20000.0},
  "piece": {"use": "pipe", "start": {"atMm": ["=receive_start_x", "=receive_start_z"]}},
  "surfaces": [
    {"name": "station chute", "material": "panel", "solid": "Station chute plate and side plates (GE-25014, GE-25004, GE-25005)"},
    {"name": "station guard", "material": "panel", "solid": "Station upper guard (GE-25017)"},
    {"name": "inlet", "material": "panel", "segmentsMm": [["=entry_x", "=entry_z"], ["=kink_x", "=kink_z"], ["=floor_end_x", "=floor_end_z"]]},
    {"name": "hood", "material": "panel", "segmentsMm": [["=hood0_x", "=hood0_z"], ["=hood1_x", "=hood1_z"]]},
    {"name": "hood flare", "material": "panel", "segmentsMm": [["=flare_x", "=flare_z"], ["=hood0_x", "=hood0_z"]]},
    {"name": "lip", "material": "panel", "segmentsMm": [["=lip_root_x", "=lip_root_z"], ["=lip_knee_x", "=lip_tip_z"], ["=lip_tip_x", "=lip_tip_z"]]},
    {
      "name": "nip",
      "material": "tread",
      "drive": "nip",
      "runs": "clockwise",
      "circleMm": {"centreMm": ["=throat_x", "=lower_roller_z"], "radiusMm": "=roller_r"}
    },
    {"name": "nip", "material": "tread", "drive": "nip", "circleMm": {"centreMm": ["=throat_x", "=upper_roller_z"], "radiusMm": "=roller_r"}}
  ],
  "flaps": [
    {
      "name": "flap",
      "material": "panel",
      "hingeMm": ["=flap_x", "=flap_hinge_z"],
      "lengthMm": "=flap_length",
      "restDirection": [0, -1],
      "inertiaKgM2": {"value": 0.00024, "assumed": [0.00012, 0.00048], "note": "1.6 mm polycarbonate plate about its pin: an estimate"},
      "preloadNm": {"value": 0.04, "assumed": [0.01, 0.08], "note": "Torsion spring preload, set on assembly; the recorded campaign tried 0.01 as a weak spring"},
      "springNmPerRad": {"value": 0.06, "assumed": [0.015, 0.12], "note": "Torsion spring rate: an estimate"},
      "dampingNmSPerRad": {"value": 0.0002, "assumed": [0.0001, 0.0004], "note": "Pin friction as viscous damping: an estimate"},
      "limitDeg": "=flap_open_deg",
      "stopRestitution": {"value": 0.3, "assumed": [0.1, 0.5], "note": "Bounce off the open stop: an estimate"}
    }
  ],
  "commands": {"nip": {"mode": "hold", "fullTorqueAtRad": 0.035, "busV": 12.0}},
  "events": [
    {"name": "left the station", "when": {"signal": "xMm", "above": "=station_sill_x"}},
    {"name": "passed flap", "when": {"signal": "xMm", "above": "=flap_x + 2 + pipe_r"}},
    {"name": "flap closed", "when": {"all": [{"after": "passed flap"}, {"signal": "hinge.flap.angleDeg", "below": 2.0}]}},
    {
      "name": "rear escape",
      "when": {"all": [{"after": "passed flap"}, {"signal": "xMm", "below": "=flap_x - 5 - pipe_r"}]},
      "outcome": "rear escape past flap"
    },
    {"name": "entered throat", "when": {"signal": "xMm", "above": "=throat_x - 2"}},
    {"name": "through", "when": {"signal": "xMm", "above": "=throat_x + 25"}, "outcome": "passed through the nip (lost forward)"},
    {"name": "lost", "when": {"any": [{"signal": "zMm", "below": 300}, {"signal": "xMm", "below": "=station_sill_x - 600"}]}, "outcome": "lost"},
    {"name": "late", "when": {"all": [{"signal": "tS", "above": 2.5}, {"notYet": "passed flap"}]}, "outcome": "did not reach the pocket"},
    {
      "name": "seated in throat",
      "when": {"all": [{"after": "passed flap"}, {"after": "entered throat"}, {"restFor": 0.15}]},
      "outcome": "seated in the nip throat"
    },
    {"name": "seated", "when": {"all": [{"after": "passed flap"}, {"restFor": 0.15}]}, "outcome": "seated"}
  ],
  "measures": {
    "stationExitS": {"timeOf": "left the station"},
    "passedFlapS": {"timeOf": "passed flap"},
    "flapClosedS": {"timeOf": "flap closed"},
    "endXMm": {"final": "xMm"},
    "endZMm": {"final": "zMm"},
    "peakSpeedMps": {"peak": "speedMps"},
    "maxFlapDeg": {"peak": "hinge.flap.angleDeg"},
    "maxBiteN": {"peak": "contact.nip.forceN"},
    "maxCurrentA": {"peak": "drive.nip.currentA"}
  },
  "pass": {"outcomes": ["seated", "seated in the nip throat"]},
  "control": {
    "change": {"materials.tread.stiffnessNPerM": 10000.0, "materials.tread.friction": 0.3, "materials.panel.friction": 0.15},
    "note": "A tread far softer and slicker than the acceptance band and a slick floor: the pipe must run through the nip."
  },
  "brackets": [
    {
      "input": "parameters.dock_gap",
      "unit": "mm",
      "values": [0, 10, 25, 50, 75, 100],
      "note": "Rear bumper to the station's lower barrier; the recorded campaign tried 0, 10 and 50"
    }
  ],
  "adjustments": ["nip squeeze", "flap preload"]
}
