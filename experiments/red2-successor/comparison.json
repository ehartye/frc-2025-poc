    {
      "id": "split-drop",
      "architecture": "Rear station cradle carries a transverse pipe; a short horizontal slide presents two split supports above the trough; the supports open sideways.",
      "interfaces": [
        {
          "from": "station operator",
          "to": "receiver",
          "exchange": "Dispenser seats both ends on the split cradle. A left/right support indication and observed end positions permit travel."
        },
        {
          "from": "receiver",
          "to": "reef",
          "exchange": "Extend to the registered drop position and splay the two supports sideways. A zero-horizontal-speed drop tests the field condition only."
        },
        {
          "from": "custody sensing",
          "to": "driver",
          "exchange": "Retract supports on independent clear signals, then retract slide before driving. Failed side opening inhibits the feed and chassis."
        },
        {
          "from": "pit crew",
          "to": "mechanism",
          "exchange": "Isolate the slide, pin the cradle, withdraw both side pivots, restore home references and confirm matching separation."
        }
      ],
