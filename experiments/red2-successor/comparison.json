  "concepts": [
    {
      "id": "tip-tray",
      "architecture": "Open rear station mouth, passively supported transverse pipe, one tipping bed and a retracting gate, forward gravity delivery.",
      "interfaces": [
        {
          "from": "station operator",
          "to": "receiver",
          "exchange": "Station feeds into a rear funnel. Two independent end witnesses must see the pipe seated before drive."
        },
        {
          "from": "receiver",
          "to": "reef",
          "exchange": "Tip to 12 degrees and open the gate after stopped pose confirmation. The 370 mm rail and 55 mm gravity run are from the conditional sweep."
        },
        {
          "from": "custody sensing",
          "to": "driver",
          "exchange": "Close the gate and stow only after custody clears. If the pipe bridges the rim, hold still, inhibit the next feed and back out only after clearance."
        },
        {
          "from": "pit crew",
          "to": "mechanism",
          "exchange": "Withdraw the gate drive outward without reaching through the pipe path. A straight downward gate would strike the trough panel; a folding gate needs a new measured sweep."
        }
      ],
