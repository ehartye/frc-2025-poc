            "sha256": "9f72cf59c6e2557bc5b42a7ce6fb7036c2b9153423af761d4907f423d1eed646"
          },
          "execution": "/runs/fixed-rollers/adverse",
          "values": {
            "retainedOnMatchedPulse": "/runs/fixed-rollers/adverse/retainedOnMatchedPulse",
            "fieldOnlySupportedFraction": "/runs/fixed-rollers/adverse/fieldOnlySupportedFraction",
            "staticStartMarginMm": "/runs/fixed-rollers/adverse/staticStartMarginMm",
            "inspectionAllocationMarginKg": "/runs/fixed-rollers/adverse/inspectionAllocationMarginKg"
          }
        }
      ]
    },
    {
      "id": "split-drop",
      "architecture": "Rear station cradle carries a transverse pipe; a short horizontal slide presents two split supports above the trough; the supports open sideways.",
      "interfaces": [
        {
          "from": "station operator",
          "to": "receiver",
          "exchange": "Dispenser seats both ends on the split cradle. A left/right support indication and observed end positions permit travel."
        },
        {
          "from": "receiver",
          "to": "reef",
          "exchange": "Extend to the registered drop position and splay the two supports sideways. A zero-horizontal-speed drop tests the field condition only."
        },
        {
          "from": "custody sensing",
          "to": "driver",
          "exchange": "Retract supports on independent clear signals, then retract slide before driving. Failed side opening inhibits the feed and chassis."
        },
        {
          "from": "pit crew",
          "to": "mechanism",
          "exchange": "Isolate the slide, pin the cradle, withdraw both side pivots, restore home references and confirm matching separation."
        }
      ],
      "runs": [
        {
          "case": "nominal",
          "source": {
            "path": "experiments/red2-successor/executions.json",
            "sha256": "9f72cf59c6e2557bc5b42a7ce6fb7036c2b9153423af761d4907f423d1eed646"
          },
          "execution": "/runs/split-drop/nominal",
          "values": {
            "retainedOnMatchedPulse": "/runs/split-drop/nominal/retainedOnMatchedPulse",
            "fieldOnlySupportedFraction": "/runs/split-drop/nominal/fieldOnlySupportedFraction",
            "staticStartMarginMm": "/runs/split-drop/nominal/staticStartMarginMm",
